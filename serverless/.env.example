# OpenCommerce · exemplo de variáveis de ambiente
# Copie para .env.local (ou cadastre em Settings → Environment Variables na Vercel).
# NUNCA faça commit do .env real.

# ---------- IA (proxy seguro) ----------
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
AI_RATE_LIMIT=30

# ---------- CORS (domínio da loja) ----------
# Aceita lista separada por vírgula. Ex.: https://minhaloja.com.br,https://vyrezstudio.github.io
ALLOWED_ORIGIN=

# ---------- Gateway PIX ----------
MP_ACCESS_TOKEN=
ASAAS_API_KEY=
ASAAS_BASE=
PAGARME_SECRET_KEY=
PAGARME_BASE=

# ---------- API própria ----------
CUSTOM_GATEWAY_URL=
CUSTOM_GATEWAY_TOKEN=

# ---------- Webhook ----------
WEBHOOK_SECRET=
ORDER_WEBHOOK_URL=
ORDER_WEBHOOK_TOKEN=